DATABASE_URL="postgresql://carmar:carmar@localhost:5432/pedidos_carmar"
JWT_SECRET="cambiar-esto-en-produccion"
PORT=3000
CORS_ORIGIN=http://localhost:5173
NODE_ENV=development
JWT_EXPIRES_IN=7d
# Excel de artículos exportado del sistema de Cármar. Ruta relativa a la raíz del repo (o absoluta).
CATALOGO_XLSX_PATH=./data/catalogo.xlsx

# Avisos Web Push (opcionales: sin estas tres variables no se manda ningun aviso).
# Generar el par de claves con: pnpm --filter api exec web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:cambiar-esto@ejemplo.com
