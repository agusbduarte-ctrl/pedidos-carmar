{
  "name": "api",
  "version": "0.0.1",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc",
    "lint": "eslint src prisma",
    "test": "vitest run",
    "seed": "tsx --env-file-if-exists=.env prisma/seed.ts",
    "import-catalogo": "tsx --env-file-if-exists=.env prisma/import-catalogo.ts",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/cors": "^10.0.0",
    "@fastify/jwt": "^10.2.5",
    "@fastify/rate-limit": "^11.2.1",
    "@prisma/client": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "fastify": "^5.12.7",
    "xlsx": "file:vendor/xlsx-0.20.3.tgz",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24",
    "eslint": "^10.13.0",
    "prisma": "^6.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  }
}