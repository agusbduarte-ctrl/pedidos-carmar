# Variables de producción. Este archivo es SOLO un modelo.
# En el servidor se copia a la raíz del repo como .env.prod y se completa:
#   cp deploy/.env.prod.example .env.prod
#   nano .env.prod
# .env.prod nunca se sube a git ni se comparte.

# Dirección de la web, sin https:// (por ejemplo pedidos.carmar.com.ar)
# Para probar sin dominio: pedidos.<IP-con-guiones>.sslip.io (ej. pedidos.54-10-20-30.sslip.io)
DOMINIO=cambiar-esto

# Clave de la base de datos. Generar con: openssl rand -hex 24
# (solo letras y números: así no rompe la dirección de conexión)
POSTGRES_PASSWORD=cambiar-esto

# Clave para firmar las sesiones. Generar con: openssl rand -hex 48
JWT_SECRET=cambiar-esto
JWT_EXPIRES_IN=7d

NODE_ENV=production

# Misma dirección que DOMINIO, con https://
CORS_ORIGIN=https://cambiar-esto

# Cantidad de proxies delante de la API (acá solo Caddy: 1)
TRUST_PROXY_HOPS=1

# Excel del catálogo, dentro del contenedor (el archivo se copia a ./data/ en el servidor)
CATALOGO_XLSX_PATH=./data/catalogo.xlsx
